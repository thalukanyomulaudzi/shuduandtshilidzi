# Copy these into your hosting provider's environment-variable settings.
# Never put live credentials in browser code or commit a real .env file.
RESEND_API_KEY=re_replace_with_a_new_private_key
WEDDING_FROM_EMAIL=Wedding RSVP <verified-sender@your-verified-domain.example>

